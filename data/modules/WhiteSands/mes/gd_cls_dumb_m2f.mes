// These are class-based NPC messages, said by dumb male NPC's to female PC's

// Asking for money messages start at 1000. 

{1000}{Me want %d coins. OK?}


// Not enough money messages start at 2000. 

{2000}{You no have da money!}



// Offers to train a beginner cannot 3000. 

{3000}{What trainin' ya want?}



// Already trained messages start at 4000. 

{4000}{You already know dat!}



// Not ready to train messages start at 5000. 

{5000}{You not know enough yet.}



// Did training messages start at 6000. 

{6000}{You now is a prentiss!}



// No rumors messages start at 7000. 

{7000}{Me know nuthin.}



// Initial great greeting messages start at 8000. 

{8000}{Hi! Me luv you!}



// Initial good greeting messages start at 9000. 

{9000}{Hi lady!}


// Initial neutral greeting messages start at 10000. 

{10000}{Er?}



// Second great greeting messages start at 11000. 

{11000}{Hi again! Me still luv you!}


// Second good greeting messages start at 12000. 

{12000}{Me see you again, lady! Hi again!}



// Second neutral greeting messages start at 13000. 

{13000}{Ug.}


// Offer healing messages start at 14000. 

{14000}{What heal you want?}



// Finished messages start at 15000. 

{15000}{Me done.}




// Greeting a PC in underwear messages start at 16000. 

{16000}{Hehe, you got no clothes on lady!}




// Greeting a PC in barbarian armor messages start at 17000. 

{17000}{You look like mean girl.}




// Fear of associates messages start at 18000. 

{18000}{You friends stink.}



// Body spell messages start at 19000. 

{19000}{You funny looking.}




// Polymorph messages start at 20000. 

{20000}{Hi. You dinner?}


// Mirror image messages start at 21000. 

{21000}{UNUSED}




// Invisibility messages start at 22000. 

{22000}{Me no see you!}
