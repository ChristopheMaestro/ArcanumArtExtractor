{114}{Quoi faire maintenant ?}{}{-4}{ss17, ss-17}{266}{}
{115}{Que devons-nous faire maintenant ?}{}{5}{ss18, ss-18}{269}{}
{116}{Quoi faire maintenant ?}{}{-4}{ss18, ss-18}{269}{}
