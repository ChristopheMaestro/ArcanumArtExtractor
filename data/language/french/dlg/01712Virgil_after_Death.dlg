{83}{K:}{}{1}{wa 0}{100}{}
{84}{J'aimerais que vous fassiez quelque chose pour moi, Virgile...}{}{5}{wa 0}{200}{}
{85}{Vous faire chose pour moi ?}{}{-4}{wa 0}{200}{}
{86}{E:}{}{1}{wa 0}{0}{}
{87}{Vous n'avez plus besoin d'attendre, Virgile...}{}{5}{wa 1}{227}{uw 0 213}
{88}{Vous plus besoin d'attendre, Virgile !}{}{-4}{wa 1}{227}{uw 0 213}
{100}{Que puis-je faire pour vous ?}{Que puis-je faire pour vous ?}{}{22}{}{}
{101}{J'aimerais en savoir plus sur vous, Virgile...}{}{5}{}{}{ce}
{102}{Moi voulois savoir plus sur vous, Vrigide !}{}{-4}{}{}{ce}
{103}{Que savez-vous sur ces lieux ?}{}{5}{ia 21}{250}{}
{104}{Où nous être ?}{}{-4}{ia 21}{250}{}
{105}{Que savez-vous sur ces lieux ?}{}{5}{ia 4}{242}{}
{106}{Où nous être ?}{}{-4}{ia 4}{242}{}
