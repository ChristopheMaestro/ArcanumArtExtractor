// These are race-based NPC messages, said by dumb male NPC's to male PC's 
// based on the PC's race 

// Insult messages start at 1000.

{1000}{Vous être personne stupide et laide !}



// Initial bad greeting messages start at 2000. 

{2000}{Quoi vouloir ?!}



// Initial worst greeting messages start at 3000.

{3000}{Moi pas vouloir parler à vous.}


// Second bad greeting messages start at 4000. 

{4000}{Pourquoi vous revenir ? Moi pas aimer vous !}



// Second worst greeting messages start at 5000. 

{5000}{Moi toujours pas vouloir parler à vous !}



// Shrink spell messages start at 6000. 

{6000}{Pourquoi vous être minuscule ?}
