// These are race-based NPC messages, said by female NPC's to male PC's
// based on the PC's race

// Insult messages start at 1000. Each PC race gets 50 messages
// starting on multiples of 50 (and the first block is reserved
// for when the NPC race is the same as the PC race)


{1000}{Espèce de vermine insolente ! Comment osez-vous ?}
{1001}{Hors de ma vue, espèce de brute minable !}
{1002}{Je ne souffrirai pas cela plus longtemps !}
{1003}{Vous n'êtes qu'une créature grossière et bornée !}
{1004}{Allez-vous-en, imbécile !}
{1005}{Flûte ! Avez-vous perdu la tête ?}
{1006}{Dégagez, sale rat !}
{1007}{De l'air, espèce d'ignoble sac à puces !}
{1008}{Fichez-moi la paix, bougre d'imbécile !}
{1009}{Je ne souffrirai aucune de vos idioties, imbécile !}
{1010}{Allez-vous-en, bougre d'imbécile !}
{1011}{Vous n'êtes qu'une innommable fripouille !}
{1012}{Espèce de sale parasite ! Sale rat ! Je déteste les gens comme vous !}
{1013}{Que regardez-vous, minable sans cerveau ?}
{1014}{Quel monceau sordide de médiocrité vous faites !}
{1015}{Je dis que vous avez complètement perdu l'esprit.}
{1016}{Que vous et les vôtres soyez maudits !}
{1017}{Que vous et votre maison soyez maudits !}
{1018}{Que vous et tout ce que vous représentez soyez maudits !}
{1019}{Votre espèce n'est qu'une race de pestiférés !}
{1020}{Quel ennui ! Vous n'êtes qu'une fripouille sans espoir.}
{1021}{Fichez-moi le camp ! Vous êtes irrécupérable.}
{1022}{Dégagez ! Vous n'êtes qu'une brute incorrigible et sans considération.}
{1023}{Vous êtes une créature perverse, pour sûr.}
{1024}{Vous êtes une imposture ambulante !}
{1025}{Balivernes ! Vous n'êtes qu'une créature indolente et paresseuse.}
{1026}{Vous n'êtes qu'une bête de somme, un simple domestique. Laissez-moi en paix !}
{1027}{Vous n'êtes qu'une canaille sans foi ni loi !}

{1050}{Que regardez-vous, déchet humain ?}
{1051}{Vous voyez ce que je vois ? Un humain imbu de sa personne et plein d'insolence !}
{1052}{Vous, les humains, n'êtes que des tas de fumier ambulants !}
{1053}{Déchet humain ! Les gens comme vous ne sont pas les bienvenus ici !}
{1054}{Je ne souffrirai aucune de vos idioties humaines, sale rat !}
{1055}{Sales humains ! Partez, espèce de lâche !}
{1056}{Regardez-moi ça : un humain gauche et maladroit !}
{1057}{Espèce de déchet humain stupide ! Partez d'ici !}
{1058}{Vous, les humains, êtes des êtres décérébrés et ennuyeux.}
{1059}{Vous, les humains, êtes trop faibles et couards pour mériter de vivre.} 
{1060}{Déchet humain ! Je vous souhaite de pourrir dans votre imbécillité.}
{1061}{Vous les humains, vous êtes au-dessous de tout !} 
{1062}{Votre espèce n'est qu'un fléau maléfique pour le monde !} 


{1100}{Dégagez, espèce de barbu loufoque !}
{1101}{Que faites-vous ici, vieux barbu dégoûtant ?}
{1102}{Vous n'avez rien à faire ici, sale barbu !}
{1103}{Dégagez, espèce de nain maladroit et minable !}
{1104}{Je ne vous aime pas, sale nain puant de pourriture !}
{1105}{Fichez-moi le camp ! Partez ou je vous taillade votre barbe dégoûtante !}
{1106}{Vous, nains paresseux et indolents, n'êtes qu'une plaie pour le monde !}
{1107}{Vous, les nains, n'êtes que des tas de fumier barbus !}
{1108}{Oh vous, espèce de barbe à noeuds irascible !}
{1109}{Allez-vous-en ou je vous tonds votre barbe puante !}
{1110}{De l'air, sale rat ! Je vous déteste, espèce de barbe à pattes !}

{1150}{Sale elfe plein d'arrogance !}
{1151}{Imbécile aux oreilles en pointe !}
{1152}{Vous, elfes paresseux et indolents, n'êtes qu'une plaie pour le monde !}
{1153}{Vous, les elfes, n'êtes que des tas de fumier parfumés !}
{1154}{Dégagez, créatures féeriques nauséabondes !}
{1155}{Dégagez ! Je ne peux plus supporter votre arrogance !}
{1156}{Espèce d'être débile aux oreilles en pointe !}
{1157}{Dégagez, cousin d'orque aux oreilles pointues !}
{1158}{De l'air, sale rat ! Je vous déteste, elfes aux oreilles en pointe !}
{1159}{Vous, elfes suffisants, ne valez pas mieux que les orques !}

{1200}{Qu'est-ce qui justifie votre arrogance, demi-elfe ?}
{1201}{Vous, les demi-elfes, n'êtes que des fous !}
{1202}{Vous, les demi-elfes aux oreilles pointues, vous n'êtes que des imbéciles ringards !}
{1203}{Espèce de demi-portion ! Je vous étriperais avec joie !}
{1204}{Vous, demi-elfes paresseux et indolents, n'êtes qu'une plaie pour le monde !}
{1205}{Vous, les demi-elfes, n'êtes que des tas de fumier parfumés !}
{1206}{Espèce de créature ignorante et sans cervelle !}
{1207}{Dégagez, imbécile de demi-elfe.}
{1208}{De l'air, sale rat ! Je vous déteste, demi-elfes !} 
{1209}{Vous, les demi-elfes, n'êtes que des sous-créatures lubriques et néfastes.}
{1210}{Bah ! Des demi-elfes ! Vous n'êtes que des hybrides sans courage aucun.}
 
{1250}{Dégagez, capitaliste arriviste !}
{1251}{Laissez libre cours à votre insolence, gnome, et je vous promets de m'occuper de vous !}
{1252}{Vous tous, escrocs, méritez la mort !}
{1253}{Sale gnome ! Qu'est-ce qui vous amène par ici ?}
{1254}{Tenez votre langue, sale gnome !}
{1255}{Vous, les gnomes, n'êtes que des tas de fumier endimanchés !}
{1256}{Dégagez, gnome ridicule et ringard !}
{1257}{Dégagez, vieille baderne sénile et malpropre !}
{1258}{De l'air, sale rat ! Je vous déteste, horribles gnomes !}
{1259}{Vous tous, gnomes belliqueux, n'êtes que des imbéciles sauvages !}

{1300}{Retournez dans votre tanière boueuse, halfelin !}
{1301}{De l'air, sale roquet !}
{1302}{Allez-vous-en, petite fripouille !}
{1303}{Vous, espèce de demi-portions, n'êtes que des imbéciles pas plus hauts que trois pommes !}
{1304}{Vous, pieds poilus pleurnicheurs, n'êtes qu'une bande de crétins insensés !}
{1305}{Vous, halfelins paresseux, n'êtes qu'une plaie pour le monde !}
{1306}{Espèce d'halfelin inculte et sans cervelle !}
{1307}{De l'air, sale rat ! Je vous déteste, halfelins obèses !}
{1308}{Vous tous, lâches aux pieds poilus, n'êtes que des crapauds !}
{1309}{Vous, les halfelins, n'êtes qu'un tas de crétins aux pieds poilus !}
{1310}{Vous n'êtes qu'un abruti aux grands pieds !}
{1311}{De l'air, petite crapule !}


{1350}{Demi-orque ? Vous sentez l'orque à plein nez !}
{1351}{Dégagez ! Vous, les demi-orques, n'êtes que des tas de crasse nauséabonds !}
{1352}{Allez-vous-en, demi-orque ! Ou je me ferai un plaisir de vous étriper !}
{1353}{De l'air, hybride ! Espèce de pourriture malhonnête, vous me dégoûtez !}
{1354}{Quittez ces lieux, créature infâme !}
{1355}{Espèce de demi-orque difforme et incapable !}
{1356}{De l'air, sale rat ! Je vous déteste, horribles demi-orques !}
{1357}{Vous, demi-orques paresseux et indolents, n'êtes qu'une plaie pour le monde !}
{1358}{Vous, les demi-orques, n'êtes que des tas de fumier sans courage !}
{1359}{Espèce de demi-orque ignare et sans cervelle !}
{1360}{Vous, stupides demi-orques, n'êtes que des sauvages et des barbares.}
{1361}{Les demi-orques ne peuvent pas s'associer aux gens normaux.}
{1362}{Vous, demi-orques répugnants, faites insulte à la lumière du jour.}

 
{1400}{Vous, les demi-ogres, n'êtes que stupidité, pas vrai ?}
{1401}{Fichez-moi le camp ! Vous, les demi-ogres, êtes des brutes épaisses !}
{1402}{Vous, les demi-ogres, n'êtes que des rustres ignorants, des gros pleins de soupe !}
{1403}{Partez, espèce d'andouille au crâne évidé !}
{1404}{De l'air, montagne de graisse ambulante !}
{1405}{Dégagez, espèce de demi-ogre incapable et ignare !}
{1406}{Vous, les demi-ogres, n'êtes que des montagnes de fumier malodorant !}
{1407}{Espèce de nullité ! Aucun d'entre vous ne peut se prévaloir d'avoir une moitié de cerveau !}
{1408}{Stupide demi-ogre servile !}
{1409}{Espèce de demi-ogre mal dégrossi !}
{1410}{De l'air, sale rat ! Je vous déteste tous autant que vous êtes, horribles demi-orques !} 
{1411}{Vous, stupides demi-ogres, n'êtes que des sauvages et des barbares.}
{1412}{Où est donc votre petit maître gnome, bougre d'imbécile ?}
{1413}{Niaiseries ! Vous n'êtes rien, vous n'êtes que des larbins de gnome.}


// Initial bad greeting messages start at 2000. Each PC race gets 50
// messages starting on multiples of 50 (and the first block is reserved
// for when the NPC race is the same as the PC race)

{2000}{Qu'est-ce que vous voulez ?}
{2001}{Qu'attendez-vous de moi ?}
{2002}{Je ne souhaite pas vous parler.}
{2003}{Pourquoi m'importunez-vous ?}
{2004}{Pourquoi me harcelez-vous ?}
{2005}{Quoi ? J'ai beaucoup à faire. Laissez-moi tranquille.}
{2006}{Que me voulez-vous donc ?}
{2007}{Qu'est-ce qui vous fait croire que je souhaite parler à quelqu'un de votre genre ?}
{2008}{Allez-y, parlez. Je n'ai pas que ça à faire.}
{2009}{Oui ? Allez-y, parlez.}
{2010}{Je ne peux pas vous aider.}
{2011}{Pourquoi m'adressez-vous la parole ?}
{2012}{Je n'ai pas de temps à consacrer à des gens comme vous.}
{2013}{Qu'est-ce que tout cela veut dire ?}
{2014}{Vous avez dû vous égarer. Vous n'avez rien à faire ici.}


{2050}{Qu'est-ce qu'un humain peut bien me vouloir ?}
{2051}{Que me voulez-vous, humain ?}
{2052}{Je n'ai pas de temps à consacrer aux humains.}
{2053}{Qu'est-ce qu'un humain peut bien attendre de moi ?}
{2054}{Allez-y, humain, parlez. Je n'ai pas que ça à faire.}
{2055}{Je n'ai pas de temps à vous consacrer, humain.}
{2056}{Je ne peux pas vous aider, humain.}
{2057}{Je n'ai pas de temps pour les gens de votre espèce, humain.}
{2058}{Je ne m'associe pas à des humains.}
{2059}{Parlez, humain. Ou peut-être ne savez-vous pas comment faire ?}
{2060}{Je ne vous connais pas, humain, et je ne veux pas vous connaître.}
{2061}{Que diable une humain peut-elle bien me vouloir ?}
{2062}{Allez-y, humain, parlez.}
{2063}{Quoi ? Demandez-vous la charité ? Qu'y a-t-il, humain ?}
{2064}{Parlez plus fort, humain. Ne marmonnez pas.}


{2100}{Je n'ai pas de temps à consacrer à des gens de votre race, nain.}
