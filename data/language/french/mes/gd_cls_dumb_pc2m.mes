// These are class-based PC messages, said to male NPC's based on their 
// class.

// Appreciation (thanks) messages start at 1000. Each class gets 50 
// messages starting on multiples of 50 

// noble 
{1000}{Marsi vous.}

// priest 
{1050}{Marsi vous.}

// wizard 
{1100}{Merci vous, monsieur effrayant.}

// technologist 
{1150}{Merci vous, monsieur de la science.}

// shopkeeper 
{1200}{Marsi !}

// guard 
{1250}{Merci vous !}

// city_dweller 
{1300}{Marsi vous, gentil monsieur.}

// villager 
{1350}{Marsi.}

// beggar 
{1400}{Marsi, vieux monsieur.}

// thief 
{1450}{Marsi !}

// bandit 
{1500}{Marsi.}

// Asking for rumors messages start at 2000. Each class gets 50 
// messages starting on multiples of 50 

// noble 
{2000}{Vous raconter moi rumeur ?}

// priest 
{2050}{Vous raconter nouvelles à moi ?}

// wizard 
{2100}{Quoi rumeur raconter ?}

// technologist 
{2150}{Quoi être nouvelles, m'sieur ?}

// shopkeeper 
{2200}{Quoi être nouvelle rumeur ?}

// guard 
{2250}{Quoi rhume ou nouvelles ?}

// city_dweller 
{2300}{Cette cité grande ! Beaucoup évènements ! Vous connaître rumeur ?}

// villager 
{2350}{Raconter moi rumeur ?}

// beggar 
{2400}{Raconter moi rumeur ?}

// thief 
{2450}{Vous raconter rumeur à moi maintenant.}

// bandit 
{2500}{Vous raconter rumeur à moi maintenant ?}


// Insult messages start at 3000. Each class gets 50 messages starting 
// on multiples of 50 

// noble 
{3000}{Vous beurk !}

// priest 
{3050}{Vous bizarre.}

// wizard 
{3100}{Vous face bouffie !}

// technologist 
{3150}{Vous bête.}

// shopkeeper 
{3200}{Vous stupide pas beau.}

// guard 
{3250}{Vous stupide méchant !}

// city_dweller 
{3300}{Moi pas aimer vous, vous stupide !}

// villager 
{3350}{Vous imbécile stupide !}

// beggar 
{3400}{Vous pas sentir bon, stupide !}

// thief 
{3450}{Vous face d'orque stupide !}

// bandit 
{3500}{Vous pas sentir bon, vous stupide pas beau.}
