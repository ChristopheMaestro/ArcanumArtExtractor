// These are class-based PC messages, said to female NPC's based on their
// class.

// Appreciation (thanks) messages start at 1000. Each class gets 50
// messages starting on multiples of 50

// noble
{1000}{Dankie fein.}

// priest
{1050}{Dankie fein.}

// wizard
{1100}{Dankie, Angs'-Frau.}

// technologist
{1150}{Dankie, Mam-Sirr.}

// shopkeeper
{1200}{Dankie!}

// guard
{1250}{Dankie!}

// city_dweller
{1300}{Dankie fein, Nett-Frau.}

// villager
{1350}{Dankie, Frau.}

// beggar
{1400}{Dankie, Alt-Frau.}

// thief
{1450}{Dankie!}

// bandit
{1500}{Dankie.}

// Asking for rumors messages start at 2000. Each class gets 50
// messages starting on multiples of 50

// noble
{2000}{Ihr mir Gerüchtens sagen?}

// priest
{2050}{Ihr sagen, was neu für mir?}

// wizard
{2100}{Was sein Gerüchtens?}

// technologist
{2150}{Was neu, Frau-Sirr?}

// shopkeeper
{2200}{Was neu Gerüchtens?}

// guard
{2250}{Was sein neu Gerüchtens?}

// city_dweller
{2300}{Das Stadt groß! Viel los! Ihr Gerüchtens wissen?}

// villager
{2350}{Mir neu Gerüchtens sagen?}

// beggar
{2400}{Mir neu Gerüchtens sagen?}

// thief
{2450}{Ihr mir neu Gerüchtens sagen. Jetz'.}

// bandit
{2500}{Ihr mir neu Gerüchtens sagen. Jetz'.}


