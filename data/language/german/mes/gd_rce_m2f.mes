// These are race-based NPC messages, said by female NPC's to female PC's
// based on the PC's race

// Insult messages start at 1000. Each PC race gets 50 messages
// starting on multiples of 50 (and the first block is reserved
// for when the NPC race is the same as the PC race)


{1000}{Was für ein unverschämter Wurm! Wie könnt Ihr es wagen?}
{1001}{Geht mir aus den Augen! So eine rüpelhafte Kreatur!}
{1002}{Das muss ich mir nicht anhören!}
{1003}{Wie ungehobelt!}
{1004}{Bleibt mir vom Hals, Schwachkopf!}
{1005}{Verdammt! Wohl verrückt geworden?}
{1006}{Verschwindet, Flohzirkus auf zwei Beinen!}
{1007}{Verschwindet, miese Ratte, die Ihr seid!}
{1008}{Lasst mich in Ruhe ... so ein Schwachkopf!}
{1009}{Ich hör mir Eure Frechheiten nicht weiter an, aufgeblasenes Ekel!}
{1010}{Verschwindet, vom Schwachsinn gebeutelte Ratte!}
{1011}{Ihr seid nichts weiter als ein armer Wicht!}
{1012}{Dreckschleuder! Laus! Ich hasse Euch alle!}
{1013}{Was gibt's da zu glotzen, Schwachkopf?}
{1014}{Was seid Ihr doch für ein schmutziges, kleines Stück Dreck!}
{1015}{Ich glaube, Ihr seid verrückt, total verrückt.}
{1016}{Die Pest über Euch und Eure Sippschaft!}
{1017}{Verflucht seid Ihr und Eure ganze Sippe!}
{1018}{Zum Teufel mit Euch und allem, was Euch gehört!}
{1019}{Ihr seid eine echte Plage!}
{1020}{Verdammt! Ihr seid eine elende Verbrecherbrut.}
{1021}{Verdammt noch mal! Bei Euch ist Hopfen und Malz verloren.}
{1022}{Dammich! Ihr seid ein unverbesserliches und rücksichtsloses Scheusal!}
{1023}{Ihr seid ein verdorbenes Subjekt, das steht fest.}
{1024}{Das ist Betrug und Scharlatanerei, was Ihr da abzieht!}
{1025}{Quatsch! Ihr seid faul, hinterhältig und ein Kretin.}
{1026}{Ihr seid ein Packesel, ein Tagelöhner, nicht mehr als ein Knecht. Lasst mich in Ruhe!}
{1027}{Ihr seid ein unmoralisches und lasterhaftes Schlitzohr!}

{1050}{Was gibt's da zu glotzen, Menschenabschaum?}
{1051}{Sieh mal einer an! Eine großmäulige, ich-bin-besser-als-du-Menschenkreatur!}
{1052}{Ihr Menschen seid nur wandelnde Haufen stinkenden Unrats!}
{1053}{Diebischer Menschenabschaum! Ihr seid hier nicht willkommen!}
{1054}{Ich lass mir von einem blöden Menschen doch nichts bieten, Dreckstück!}
{1055}{Widerliche Menschen! Verschwindet, feiger Abschaum!}
{1056}{Seht Euch das an: ein plumper, grobschlächtiger Mensch!}
{1057}{So ein dummer Schweinehund von einem Mensch! Haut ab!}
{1058}{Ihr Menschen seid nichts als ein langweiliger, hohlköpfiger Haufen.}
{1059}{Ihr Menschen seid schwach und feige, lebensunfähig.} 
{1060}{Menschen-Abschaum! Verrotten sollt Ihr.}
{1061}{Ihr Menschen seid unter aller Würde!} 
{1062}{Euresgleichen ist eine üble Plage für die gesamte Welt!} 


{1100}{Verschwindet, verrückter, alter Zickenbart!}
{1101}{Was habt Ihr hier zu suchen, alter, krausbärtiger Dummkopf?}
{1102}{Ihr gehört nicht hierher, dreckiges Bartgesicht!}
{1103}{Verschwindet, tolpatschiger, widerlicher Zwerg, der Ihr seid!}
{1104}{Euer Gestank ekelt mich an, vergammelter, Eier legender Zwerg!}
{1105}{Verdammt noch mal! Verschwindet, oder ich schneid' Euch Euren dreckigen Bart ab!}
{1106}{Ihr faulen, hinterhältigen Zwerge seid eine Plage für die gesamte Welt!}
{1107}{Ihr Zwerge seid allesamt bärtige Haufen stinkenden Unrats!}
{1108}{Streitsüchtige Zottelbärte, einer wie der andere!}
{1109}{Bleibt mir vom Leib, oder ich schneid' Euch Euren stinkenden Bart ab!}
{1110}{Haut ab, Ratte, elendige! Ich hasse euch, ihr Bärte auf Beinen!}

{1150}{So ein elender, arroganter Elf!}
{1151}{So ein verdammter, spitzohriger Blümchenknicker!}
{1152}{Ihr faulen, hinterhältigen Elfen seid eine verdammte Plage für die gesamte zivilisierte Welt!}
{1153}{Ihr Elfen seid doch nur herumhüpfende Haufen nach Parfüm stinkenden Unrats!}
{1154}{Verschwindet, herumhopsende Blumenfee, die Ihr seid!}
{1155}{Dammich! Ich hör mir Euer arrogantes Elfengeschwätz nicht länger an!}
{1156}{Dummkopf, spitzohrig und dämlich!}
{1157}{Verschwindet, spitzohrige Kreatur, habt wohl einen Ork als Cousin!}
{1158}{Haut ab, Ratte, elendige! Ich hasse euch, ihr eierköpfigen Elfen!}
{1159}{Ihr ach-so-heiligen-Elfen seid nicht besser als Orks!}

{1200}{Für Arroganz gibt es bei Halbies wie Euch wahrlich keinen Grund.}
{1201}{Ihr Halb-Elfen seid total verblödet, alle!}
{1202}{Ihr schmierigen, spitzohrigen Halbies seid doch Schwachköpfe!}
{1203}{So ein abgebrochener Halb-Elf! Ich mach Strumpfhalter aus Euren Eingeweiden!}
{1204}{Ihr faulen, hinterhältigen Halb-Elfen seid eine Plage für die gesamte Welt!}
{1205}{Ihr Halb-Elfen seid doch nur Haufen nach Parfüm stinkenden Dungs!}
{1206}{So ein ignoranter, gehirnamputierter Halb-Elf!}
{1207}{Verschwindet, verdammtes Halb-Elfengezücht!}
{1208}{Haut ab, Ratte, elendige! Ich hasse euch Halb-Elfen!} 
{1209}{Dieser Halb-Elfen-Abschaum ist lüstern und verdorben!}
{1210}{Pah! Halb-Elfen! Allesamt feige Bastarde.}
 
{1250}{Zur Hölle mit Euch, reiches Kapitalistenschwein!}
{1251}{Noch ein Wort, Gnom, und ich zeig' Euch, wo der Hammer hängt!}
{1252}{Ihr mickrigen Geldgrabscher sollt alle zur Hölle fahren!}
{1253}{Dreckiger Gnom! Was habt Ihr hier zu suchen?}
{1254}{Halt's Maul, widerliches Gnomgesindel!}
{1255}{Ihr Gnome seid allesamt in Anzügen herumstolzierende Haufen stinkenden Unrats!}
{1256}{Was für ein schmieriger, kleiner Gnom! Verschwindet!}
{1257}{Verschwindet, verrückter, vergammelter Gnom!}
{1258}{Haut ab, Ratte, elendige! Ich hasse euch, ihr ekligen Gnome!}
{1259}{Ihr streitlustigen Gnome seid nicht besser als Tiere, einer wie der andere!}

{1300}{Kriecht in Eure schmutzigen Löcher zurück, Halbling!}
{1301}{Verschwindet, nichtsnutziger Wadenbeißer!}
{1302}{Verschwindet, kleine, diebische Elster, die Ihr seid!}
{1303}{Ihr abgebrochenen Riesen habt nicht nur keine Schuhe, sondern auch keine Ahnung!}
{1304}{Ihr rotznasigen Haarfüßer seid ein faules Pack!}
{1305}{Ihr faulen Halblinge seid eine echte Schande für die Welt!}
{1306}{Immer diese Halblinge, ignorant und hirnamputiert!}
{1307}{Haut ab, Ratte, elendige! Ich hasse euch, ihr fetten Halblinge!}
{1308}{Ihr feigen Haarfüßer seid doch allesamt Kröten!}
{1309}{Ihr Halblinge seid allesamt ein Haufen haarfüßiger Trottel!}
{1310}{So ein plattfüßiges Kamel!}
{1311}{Haut ab, kleines, diebisches Monster, das Ihr seid!}


{1350}{Halb-Ork? Ihr riecht mir ganz nach einem Voll-Ork!}
{1351}{Dammich! Ihr Halb-Orks seid dreckige Wichte!}
{1352}{Verschwindet, Halb-Ork! Oder ich mach' Strumpfhalter aus Euren Eingeweiden!}
{1353}{Verschwindet, Halbie! Ihr diebischen Miststücke widert mich an!}
{1354}{Macht, dass Ihr rauskommt, verkommene Kröte!}
{1355}{Ihr seid doch bloß faule, nichtsnutzige, üble Halb-Orks!}
{1356}{Haut ab, Ratte, elendige! Ich hasse euch widerliche Halb-Orks!}
{1357}{Ihr faulen, hinterhältigen Halb-Orks seid eine Plage für die gesamte Welt!}
{1358}{Ihr Halb-Orks seid feige Haufen stinkenden Unrats!}
{1359}{Immer diese ignoranten, gehirnamputierten Halb-Orks!}
{1360}{Ihr stupiden Halb-Orks seid ein unzivilisierter, barbarischer Haufen!}
{1361}{Halb-Orks sind der Stein im Schuh von ordentlichen Leuten.}
{1362}{Ihr abstoßenden Halb-Orks solltet euch besser nicht bei Tageslicht blicken lassen.}

 
{1400}{Ihr Halb-Oger seid schon ein ziemlich blöder Haufen!}
{1401}{Verdammt noch mal! Ihr Riesen-Halbies seid so dämlich wie ihr groß seid!}
{1402}{Ihr Halb-Oger seid allesamt ignorante, aufgeblasene Muskelpakete!}
{1403}{Verschwindet, dämlicher, dickschädeliger Tölpel!}
{1404}{Los, abhauen, Berg auf Beinen!}
{1405}{Verschwindet, fauler, ignoranter Halb-Oger!}
{1406}{Ihr Halb-Oger seid herumtrampelnde Berge stinkenden Dungs!}
{1407}{So viel Schwachsinn auf einmal! Bei euch Halb-Ogern gibt es aber auch nicht einen, der halbwegs ein Hirn hat!}
{1408}{So ein ignoranter Halb-Oger-Trampel!}
{1409}{Was für ein stupides, schwachsinniges Exemplar von einem Halb-Oger!}
{1410}{Haut ab, Ratte, elendige! Ich hasse euch widerlichen Halb-Oger!} 
{1411}{Ihr stupiden Halb-Oger seid ein unzivilisierter, barbarischer Haufen!}
{1412}{Wo ist dein Gnomenherrchen, Dummkopf?}
{1413}{Parbleu! Halb-Oger - nichts weiter als Knechte von Gnomaffen!}


// Initial bad greeting messages start at 2000. Each PC race gets 50
// messages starting on multiples of 50 (and the first block is reserved
// for when the NPC race is the same as the PC race)

{2000}{Was wollt Ihr?}
{2001}{Was wollt Ihr von mir?}
{2002}{Ich möchte nicht mit Euch reden.}
{2003}{Warum belästigt Ihr mich?}
{2004}{Warum belästigt Ihr mich?}
{2005}{Was? Ich bin beschäftigt. Lasst mich in Ruhe.}
{2006}{Was könntet Ihr wohl von mir wollen?}
{2007}{Was bringt Euch auf die Idee, dass ich mich mit jemandem wie Euch unterhalten möchte?}
{2008}{Na los. Ich habe nicht den ganzen Tag Zeit.}
{2009}{Ja? Na los.}
{2010}{Ich kann Euch nicht helfen.}
{2011}{Warum belästigt Ihr mich?}
{2012}{Ich habe keine Zeit für Euresgleichen.}
{2013}{Was hat das zu bedeuten?}
{2014}{Ihr müsst Euch verlaufen haben. Ihr gehört nicht hierher.}


{2050}{Was könnte ein Mensch wohl von mir wollen?}
{2051}{Was wollt Ihr, Mensch?}
{2052}{Ich habe keine Zeit für Menschen.}
{2053}{Was könnte ein Mensch von mir wollen?}
{2054}{Heraus damit, Mensch. Ich habe nicht den ganzen Tag Zeit.}
{2055}{Ich habe keine Zeit für Euch, Mensch.}
{2056}{Ich kann Euch nicht helfen, Mensch.}
{2057}{Ich habe keine Zeit für Euresgleichen, Mensch.}
{2058}{Ich gebe mich nicht mit Menschen ab.}
{2059}{Sprecht, Mensch. Oder wisst Ihr nicht, wie das geht?}
{2060}{Ich kenne Euch nicht, Mensch, und möchte auch nicht Eure Bekanntschaft machen.}
{2061}{Was könnte ein Mensch schon von mir wollen?}
{2062}{Heraus damit, Mensch.}
{2063}{Was? Kommt Ihr etwa betteln? Worum geht es, Mensch?}
{2064}{Sprecht lauter, Mensch. Murmelt nicht so in Euren Bart hinein.}


