{204}{Hierher kommen, Wiggel!}{}{-4}{}{0}{sc}
{205}{Wartet hier ein Weilchen ...}{}{5}{wa 0}{216}{wa}
{206}{Äh, Ihr hier bisschen warten ...}{}{-4}{wa 0}{216}{wa}
{207}{Euer Warten hat jetzt ein Ende, Virgil.}{}{5}{wa 1}{227}{uw 0 213}
{208}{Nich' mehr warten! Ihr kommen wieda mi'.}{}{-4}{wa 1}{227}{uw 0 213}
{209}{Ihr solltet die Gruppe lieber verlassen.}{}{5}{}{219}{lv}
{210}{Ich Euch nich' mehr willen in Gruppe ha'm ...}{}{-4}{}{219}{lv}
{211}{[zurück]}{}{1}{}{80}{}
{213}{Wir können gehen, wenn Ihr bereit seid ...}{Wir können gehen, wenn Ihr bereit seid ...}{}{24}{}{}
