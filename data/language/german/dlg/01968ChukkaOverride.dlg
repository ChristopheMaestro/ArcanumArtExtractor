{12016}{Chukka nich' folgen bösig Mann.}{Chukka nich' folgen bösig Frau.}{}{}{}{}
{12017}{Chukka hassen Euch. Nich' folgen.}{Chukka hassen Euch. Nich' folgen.}{}{}{}{}
{12018}{Chukka sagen Tschö.}{Chukka sagen Tschö.}{}{}{}{}
{12019}{Chukka geh'n weg.}{Chukka geh'n weg.}{}{}{}{}
{12020}{Ja, Meister.}{Ja, Meister.}{}{}{}{}
{12021}{Nein, Meister.}{Nein, Meister.}{}{}{}{}
{12022}{Bitte nich' hauen Chukka.}{Bitte nich' hauen Chukka.}{}{}{}{}
{12023}{Meister schlagen bösig Leutens. He.}{Meister schlagen bösig Leutens. He.}{}{}{}{}
{12024}{Meister mussen mehr üben.}{Meister mussen mehr üben.}{}{}{}{}
{12026}{Chukka nich' folgen. Zu viel Leutens.}{Chukka nich' folgen. Zu viel Leutens.}{}{}{}{}
{12027}{Chukka nich' folgen. Ihr nich' Anführer.}{Chukka nich' folgen. Ihr nich' Anführer.}{}{}{}{}
{12028}{Chukka nich' folgen. Ihr zu schwach.}{Chukka nich' folgen. Ihr zu schwach.}{}{}{}{}
{12029}{Chukka rennen.}{Chukka rennen.}{}{}{}{}
{12047}{Nich' kämpfen gegen Freundens.}{Nich' kämpfen gegen Freundens.}{}{}{}{}
{12048}{Ihr nich' angreifen gutt Leutens.}{Ihr nich' angreifen gutt Leutens.}{}{}{}{}
{12049}{Ihr nich' angreifen mein Leutens.}{Ihr nich' angreifen mein Leutens.}{}{}{}{}
{12050}{Ihr nich' angreifen mein Leutens.}{Ihr nich' angreifen mein Leutens.}{}{}{}{}
{12052}{Chukka geh'n weg, wenn Ihr mehr bösig.}{Chukka geh'n weg, wenn Ihr mehr bösig.}{}{}{}{}
{12053}{Chukka Euch nich' mehr magen. Chukka vielleich' geh'n.}{Chukka Euch nich' mehr magen. Chukka vielleich' geh'n.}{}{}{}{}
{12054}{Chukka Aua haben! Chukka sterben!}{Chukka Aua haben! Chukka sterben!}{}{}{}{}

