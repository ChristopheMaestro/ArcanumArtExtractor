// These are class-based PC messages, said to male NPC's based on their
// class.

// Appreciation (thanks) messages start at 1000. Each class gets 50
// messages starting on multiples of 50

// noble
{1000}{Пасиба.}

// priest
{1050}{Пасиба.}

// wizard
{1100}{Пасибо, страшила.}

// technologist
{1150}{Спасибо, научный сэр.}

// shopkeeper
{1200}{Ага!}

// guard
{1250}{Пасибо!}

// city_dweller
{1300}{Пасибо, добрый сэр.}

// villager
{1350}{Пасибо.}

// beggar
{1400}{Пасиба, старина.}

// thief
{1450}{Ага!}

// bandit
{1500}{Пасибо.}

// Asking for rumors messages start at 2000. Each class gets 50
// messages starting on multiples of 50

// noble
{2000}{Вы говорить мне сказки?}

// priest
{2050}{Вы говорить новости?}

// wizard
{2100}{Что такое слухи?}

// technologist
{2150}{Что за новости, сэр?}

// shopkeeper
{2200}{Что за слухи есть новости?}

// guard
{2250}{Твои ухи слышали слухи?}

// city_dweller
{2300}{Это город большой! Много происходить! Вы иметь слух?}

// villager
{2350}{Рассказать мне новый слух?}

// beggar
{2400}{Рассказать мне новый слух?}

// thief
{2450}{Вы сейчас рассказать мне новый слухи.}

// bandit
{2500}{Вы сейчас рассказать мне новый слухи?}


// Insult messages start at 3000. Each class gets 50 messages starting
// on multiples of 50

// noble
{3000}{Ты вонючка!}

// priest
{3050}{Ты смешной.}

// wizard
{3100}{Ты тупоголовый!}

// technologist
{3150}{Ты тупица.}

// shopkeeper
{3200}{Ты уродливый и тупой.}

// guard
{3250}{Злой дурак!}

// city_dweller
{3300}{Твоя мне не нравиться, козел!}

// villager
{3350}{Тупой даун!}

// beggar
{3400}{Вонючка!!!}

// thief
{3450}{Тупой орк!}

// bandit
{3500}{Ты уродливая, тупая вонючка.}
