# object.patch
# Patches objects and mobiles in the running game whenever the
# map is loaded.
# Format:
#  OBJ_ID: attribute1 value1 attribute2 value2 attributeN valueN
#
# Legal attributes:
#  internal_name
#  known_name
#  alignment
#  origin
#  notify_npc
#  magic_hit_adjust
#  obj_flag	(OF_OFF)   (note: !OF_FLAG removes the OF_FLAG)
#  training (st_untrained|st_beginner|st_expert|st_master) (bs_bow|bs_dodge|ts_repair|etc)
#  script (Attachment point number) (script number)
#  daystand (x coordinate) (y coordinate)
#  nightstand (x coordinate) (y coordinate)
# Example: 
#   G_ADECC642_F23D_4CF4_8E1F_71EC9CF6C87E: internal_name 1234 obj_flag OF_OFF training st_expert ts_firearms
