// These are class-based PC messages, said to male NPC's based on their
// class.

// Appreciation (thanks) messages start at 1000. Each class gets 50
// messages starting on multiples of 50

// noble
{1000}{Tank you.}

// priest
{1050}{Tank you.}

// wizard
{1100}{Tanx you, scary man.}

// technologist
{1150}{Tanx you, scientrifigul sir.}

// shopkeeper
{1200}{Tanks!}

// guard
{1250}{Tanx you!}

// city_dweller
{1300}{Tank you, nice man.}

// villager
{1350}{Tanks.}

// beggar
{1400}{Tanks, old man.}

// thief
{1450}{Tanks!}

// bandit
{1500}{Tanks.}

// Asking for rumors messages start at 2000. Each class gets 50
// messages starting on multiples of 50

// noble
{2000}{You tell me rumor?}

// priest
{2050}{You say whut news for me?}

// wizard
{2100}{Whut is rumor stuff?}

// technologist
{2150}{Whut is news, man sir?}

// shopkeeper
{2200}{Whut rumor be news?}

// guard
{2250}{Whut room or news?}

// city_dweller
{2300}{This city big! Lots happen! You gots rumor?}

// villager
{2350}{Tell me news rumor?}

// beggar
{2400}{Tell me news rumor?}

// thief
{2450}{You tell rumor news me now.}

// bandit
{2500}{You tell rumor news me now.?}


// Insult messages start at 3000. Each class gets 50 messages starting
// on multiples of 50

// noble
{3000}{You stinky-face!}

